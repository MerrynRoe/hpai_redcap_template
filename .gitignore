# Session Data files
.RData
.RDataTmp
.Rhistory

#User-specific files
.Ruserdata

# RStuidio files
.Rproj.user/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Ignore html and word filetypes e.g rendered notebook or Rmd outputs
*.nb.htm
*.html
*.rmarkdown
*.docx

# R Environment Variables
.Renviron

# Keep folders
!outputs/
!raw_data/

# Ignore everything in these folders
outputs/*
raw_data/*

# But keep files ending in _template (any extension)
!outputs/*_template.*
!raw_data/*_template.*

# Ignore files created in QDM rendering
06_Basic Reporting Metrics_files/
